{
  "name": "simplfy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Study buddy for statistics and tuberculosis biology: analogy, worked problems, practice, say it back.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:rules-parity": "node scripts/check-shared-rules.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude tests/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --project demo-simplfy --only firestore \"vitest run tests/firestore.rules.test.ts --testTimeout=60000\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
